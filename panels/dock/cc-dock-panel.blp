using Gtk 4.0;
using Adw 1;

template $CcDockPanel: $CcPanel {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.ToastOverlay toast_overlay {
      child: Adw.PreferencesPage preferences_page {
        Adw.PreferencesGroup {
          title: _("Saveurs du bureau");
          description: _("Sélectionnez et appliquez une disposition prédéfinie pour le bureau Arrera Blue.");

          Adw.ActionRow flavor_default_row {
            title: _("Arrera par défaut");
            subtitle: _("Dock en bas centré à masquage auto, barre supérieure standard et menu complet");
            icon-name: "preferences-desktop-display-symbolic";

            [suffix]
            Button {
              label: _("Appliquer");
              valign: center;
              clicked => $on_apply_flavor_default_clicked(template);
              styles ["suggested-action"]
            }
          }

          Adw.ActionRow flavor_noappmenu_row {
            title: _("Menu d'application GNOME");
            subtitle: _("Disposition Arrera par défaut avec la grille d'applications native de GNOME");
            icon-name: "view-app-grid-symbolic";

            [suffix]
            Button {
              label: _("Appliquer");
              valign: center;
              clicked => $on_apply_flavor_noappmenu_clicked(template);
              styles ["suggested-action"]
            }
          }

          Adw.ActionRow flavor_windows_row {
            title: _("Disposition Windows 10/11");
            subtitle: _("Barre des tâches permanente en bas, menu compact en bas à gauche et barre supérieure masquée");
            icon-name: "computer-symbolic";

            [suffix]
            Button {
              label: _("Appliquer");
              valign: center;
              clicked => $on_apply_flavor_windows_clicked(template);
              styles ["suggested-action"]
            }
          }

          Adw.ActionRow flavor_windows_activity_row {
            title: _("Disposition Windows 10/11 avec activity button");
            subtitle: _("Barre des tâches permanente en bas avec le bouton Activités Arrera intégré");
            icon-name: "computer-symbolic";

            [suffix]
            Button {
              label: _("Appliquer");
              valign: center;
              clicked => $on_apply_flavor_windows_activity_clicked(template);
              styles ["suggested-action"]
            }
          }

          Adw.ActionRow flavor_nextstep_row {
            title: _("Bureau NeXTStep");
            subtitle: _("Inspiré de NeXTSTEP : dock à tuiles détachées à droite, contrôles intégrés et barre supérieure masquée");
            icon-name: "user-desktop-symbolic";

            [suffix]
            Button {
              label: _("Appliquer");
              valign: center;
              clicked => $on_apply_flavor_nextstep_clicked(template);
              styles ["suggested-action"]
            }
          }
        }
      };
    };
  };
}
