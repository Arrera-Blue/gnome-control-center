using Gtk 4.0;
using Adw 1;

template $CcDockPanel: $CcPanel {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.ToastOverlay toast_overlay {
      child: Adw.PreferencesPage preferences_page {
        Adw.PreferencesGroup {
          title: _("Saveurs du bureau");
          description: _("Cliquez sur une disposition pour l'appliquer à votre bureau Arrera Blue.");

          Grid {
            column-homogeneous: true;
            column-spacing: 16;
            row-spacing: 16;
            hexpand: true;
            margin-top: 12;

            // 1. Arrera par défaut
            Box card_default {
              orientation: vertical;
              styles ["card", "flavor-card"]
              layout {
                column: 0;
                row: 0;
              }

              Button {
                clicked => $on_apply_flavor_default_clicked(template);
                styles ["flat"]
                margin-start: 8;
                margin-end: 8;
                margin-top: 8;
                margin-bottom: 4;
                tooltip-text: _("Cliquer pour appliquer cette disposition");

                child: Box {
                  styles ["frame"]
                  overflow: hidden;

                  Picture {
                    can-shrink: true;
                    content-fit: contain;
                    height-request: 130;
                    file: "resource:///org/gnome/control-center/dock/assets/flavor-default.svg";
                  }
                };
              }

              Box {
                orientation: horizontal;
                halign: center;
                margin-bottom: 8;
                margin-top: 2;

                MenuButton {
                  styles ["flat"]
                  valign: center;

                  child: Box {
                    orientation: horizontal;
                    spacing: 6;

                    Image {
                      icon-name: "dialog-information-symbolic";
                    }

                    Label {
                      label: _("Description");
                    }
                  };

                  popover: Popover {
                    Box {
                      orientation: vertical;
                      spacing: 6;
                      margin-top: 12;
                      margin-bottom: 12;
                      margin-start: 12;
                      margin-end: 12;

                      Label {
                        label: _("Arrera par défaut");
                        styles ["heading"]
                      }

                      Label {
                        label: _("Dock flottant en bas centré, barre supérieure standard, menu d'applications complet et Arrera Spot.");
                        wrap: true;
                        max-width-chars: 30;
                      }
                    }
                  };
                }
              }
            }

            // 2. Menu d'application GNOME
            Box card_noappmenu {
              orientation: vertical;
              styles ["card", "flavor-card"]
              layout {
                column: 1;
                row: 0;
              }

              Button {
                clicked => $on_apply_flavor_noappmenu_clicked(template);
                styles ["flat"]
                margin-start: 8;
                margin-end: 8;
                margin-top: 8;
                margin-bottom: 4;
                tooltip-text: _("Cliquer pour appliquer cette disposition");

                child: Box {
                  styles ["frame"]
                  overflow: hidden;

                  Picture {
                    can-shrink: true;
                    content-fit: contain;
                    height-request: 130;
                    file: "resource:///org/gnome/control-center/dock/assets/flavor-noappmenu.svg";
                  }
                };
              }

              Box {
                orientation: horizontal;
                halign: center;
                margin-bottom: 8;
                margin-top: 2;

                MenuButton {
                  styles ["flat"]
                  valign: center;

                  child: Box {
                    orientation: horizontal;
                    spacing: 6;

                    Image {
                      icon-name: "dialog-information-symbolic";
                    }

                    Label {
                      label: _("Description");
                    }
                  };

                  popover: Popover {
                    Box {
                      orientation: vertical;
                      spacing: 6;
                      margin-top: 12;
                      margin-bottom: 12;
                      margin-start: 12;
                      margin-end: 12;

                      Label {
                        label: _("Menu d'application GNOME");
                        styles ["heading"]
                      }

                      Label {
                        label: _("Disposition Arrera par défaut avec la vue et grille d'applications native de GNOME.");
                        wrap: true;
                        max-width-chars: 30;
                      }
                    }
                  };
                }
              }
            }

            // 3. Disposition Windows 10/11
            Box card_windows {
              orientation: vertical;
              styles ["card", "flavor-card"]
              layout {
                column: 0;
                row: 1;
              }

              Button {
                clicked => $on_apply_flavor_windows_clicked(template);
                styles ["flat"]
                margin-start: 8;
                margin-end: 8;
                margin-top: 8;
                margin-bottom: 4;
                tooltip-text: _("Cliquer pour appliquer cette disposition");

                child: Box {
                  styles ["frame"]
                  overflow: hidden;

                  Picture {
                    can-shrink: true;
                    content-fit: contain;
                    height-request: 130;
                    file: "resource:///org/gnome/control-center/dock/assets/flavor-windows.svg";
                  }
                };
              }

              Box {
                orientation: horizontal;
                halign: center;
                margin-bottom: 8;
                margin-top: 2;

                MenuButton {
                  styles ["flat"]
                  valign: center;

                  child: Box {
                    orientation: horizontal;
                    spacing: 6;

                    Image {
                      icon-name: "dialog-information-symbolic";
                    }

                    Label {
                      label: _("Description");
                    }
                  };

                  popover: Popover {
                    Box {
                      orientation: vertical;
                      spacing: 6;
                      margin-top: 12;
                      margin-bottom: 12;
                      margin-start: 12;
                      margin-end: 12;

                      Label {
                        label: _("Disposition Windows 10/11");
                        styles ["heading"]
                      }

                      Label {
                        label: _("Barre des tâches permanente en bas pleine largeur, menu compact en bas à gauche et barre supérieure masquée.");
                        wrap: true;
                        max-width-chars: 30;
                      }
                    }
                  };
                }
              }
            }

            // 4. Disposition Windows 10/11 avec activity button
            Box card_windows_activity {
              orientation: vertical;
              styles ["card", "flavor-card"]
              layout {
                column: 1;
                row: 1;
              }

              Button {
                clicked => $on_apply_flavor_windows_activity_clicked(template);
                styles ["flat"]
                margin-start: 8;
                margin-end: 8;
                margin-top: 8;
                margin-bottom: 4;
                tooltip-text: _("Cliquer pour appliquer cette disposition");

                child: Box {
                  styles ["frame"]
                  overflow: hidden;

                  Picture {
                    can-shrink: true;
                    content-fit: contain;
                    height-request: 130;
                    file: "resource:///org/gnome/control-center/dock/assets/flavor-windows-activity.svg";
                  }
                };
              }

              Box {
                orientation: horizontal;
                halign: center;
                margin-bottom: 8;
                margin-top: 2;

                MenuButton {
                  styles ["flat"]
                  valign: center;

                  child: Box {
                    orientation: horizontal;
                    spacing: 6;

                    Image {
                      icon-name: "dialog-information-symbolic";
                    }

                    Label {
                      label: _("Description");
                    }
                  };

                  popover: Popover {
                    Box {
                      orientation: vertical;
                      spacing: 6;
                      margin-top: 12;
                      margin-bottom: 12;
                      margin-start: 12;
                      margin-end: 12;

                      Label {
                        label: _("Disposition Windows 10/11 avec activity button");
                        styles ["heading"]
                      }

                      Label {
                        label: _("Barre des tâches permanente en bas avec le bouton Activités Arrera intégré et menu compact.");
                        wrap: true;
                        max-width-chars: 30;
                      }
                    }
                  };
                }
              }
            }

            // 5. Bureau NeXTStep
            Box card_nextstep {
              orientation: vertical;
              styles ["card", "flavor-card"]
              layout {
                column: 0;
                row: 2;
              }

              Button {
                clicked => $on_apply_flavor_nextstep_clicked(template);
                styles ["flat"]
                margin-start: 8;
                margin-end: 8;
                margin-top: 8;
                margin-bottom: 4;
                tooltip-text: _("Cliquer pour appliquer cette disposition");

                child: Box {
                  styles ["frame"]
                  overflow: hidden;

                  Picture {
                    can-shrink: true;
                    content-fit: contain;
                    height-request: 130;
                    file: "resource:///org/gnome/control-center/dock/assets/flavor-nextstep.svg";
                  }
                };
              }

              Box {
                orientation: horizontal;
                halign: center;
                margin-bottom: 8;
                margin-top: 2;

                MenuButton {
                  styles ["flat"]
                  valign: center;

                  child: Box {
                    orientation: horizontal;
                    spacing: 6;

                    Image {
                      icon-name: "dialog-information-symbolic";
                    }

                    Label {
                      label: _("Description");
                    }
                  };

                  popover: Popover {
                    Box {
                      orientation: vertical;
                      spacing: 6;
                      margin-top: 12;
                      margin-bottom: 12;
                      margin-start: 12;
                      margin-end: 12;

                      Label {
                        label: _("Bureau NeXTStep");
                        styles ["heading"]
                      }

                      Label {
                        label: _("Inspiré de NeXTSTEP : dock à tuiles détachées à droite, contrôles intégrés, barre supérieure masquée et Arrera Spot.");
                        wrap: true;
                        max-width-chars: 30;
                      }
                    }
                  };
                }
              }
            }
          }
        }

        Adw.PreferencesGroup {
          title: _("Paramètres du dock");

          Adw.SwitchRow autohide_row {
            title: _("Masquage automatique du dock");
            subtitle: _("Masque automatiquement le dock lorsqu'une fenêtre le chevauche");
          }

          Adw.ComboRow icon_size_row {
            title: _("Taille des icônes");
            model: StringList {
              strings [
                _("Petite"),
                _("Moyenne"),
                _("Grande"),
              ]
            };
          }

          Adw.ComboRow position_row {
            title: _("Emplacement du dock");
            model: StringList {
              strings [
                _("En bas"),
                _("À gauche"),
                _("À droite"),
              ]
            };
          }
        }

        Adw.PreferencesGroup {
          title: _("Couleurs et thèmes");

          Adw.ComboRow dock_theme_row {
            title: _("Thème visuel Arrera");
            subtitle: _("Style appliqué au dock, au lanceur et à Spot");
            model: StringList {
              strings [
                _("Expressif (fond teinté)"),
                _("Contour accentué"),
                _("Standard GNOME"),
                _("Noir"),
                _("Blanc"),
              ]
            };
          }

          Adw.ComboRow topbar_theme_row {
            title: _("Thème de la barre supérieure");
            model: StringList {
              strings [
                _("Standard GNOME"),
                _("Transparent (invisible)"),
                _("Sombre teinté"),
                _("Clair teinté"),
              ]
            };
          }

          Adw.ComboRow logo_color_row {
            title: _("Couleur du logo Arrera");
            model: StringList {
              strings [
                _("Couleur d'accentuation"),
                _("Blanc"),
                _("Noir"),
              ]
            };
          }
        }

        Adw.PreferencesGroup {
          title: _("Recherche et raccourcis");

          Adw.SwitchRow spot_row {
            title: _("Arrera Spot");
            subtitle: _("Barre de recherche rapide Spotlight (Super+Espace)");
          }

          Adw.SwitchRow shake_screenshot_row {
            title: _("Capture d'écran par secouement");
            subtitle: _("Déclenche l'outil de capture en secouant rapidement la souris");
          }
        }
      };
    };
  };
}
